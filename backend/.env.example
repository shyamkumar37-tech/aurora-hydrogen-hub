# MongoDB Connection String (Required)
# Example for local: mongodb://localhost:27017/hydrogen-station
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hydrogen-station
MONGO_URI=mongodb://localhost:27017/hydrogen-station

# JWT Secret Key (Required for authentication)
# Generate a strong random string for production
JWT_SECRET=your_jwt_secret_key_here

# Port for the Node/Express server (Optional, defaults to 5000)
PORT=5000
