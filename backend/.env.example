# MongoDB Connection String (Required)
# Example for local: mongodb://localhost:27017/hydrogen-station
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hydrogen-station
MONGO_URI=mongodb://localhost:27017/hydrogen-station

# JWT Secret Key (Required for authentication)
JWT_SECRET=your_jwt_secret_key_here

# Port for the Node/Express server (Optional, defaults to 5000)
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# Gemini AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway (Optional / Sandbox)
RAZORPAY_KEY=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=your_stripe_secret_key

# -------------------------------------------------------------
# Real-World Communications (Optional - 100% Free Tiers Supported)
# -------------------------------------------------------------
# Option A: 100% Free Gmail App Password (up to 500 emails/day)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_16_digit_app_password

# Option B: Resend (3,000 free emails/mo) or SendGrid (100 free emails/day)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key_here
# EMAIL_FROM="Aurora Hydrogen Network" <onboarding@resend.dev>

# SMS & WhatsApp Notifications (Twilio Free Trial ~$15 credits)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# EMERGENCY_DISPATCH_PHONE=+919876543210
